{
  "id": "io.github.janick_foundry.AmpGhost",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "ampghost",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=all"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "ampghost",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/ampghost/cargo",
          "CARGO_NET_OFFLINE": "true"
        }
      },
      "build-commands": [
        "cargo --offline build --release --locked --ignore-rust-version -p ampghost-gtk",
        "install -Dm755 target/release/ampghost -t /app/bin",
        "install -Dm644 crates/ampghost-gtk/data/io.github.janick_foundry.AmpGhost.desktop -t /app/share/applications",
        "install -Dm644 crates/ampghost-gtk/data/io.github.janick_foundry.AmpGhost.metainfo.xml -t /app/share/metainfo",
        "install -Dm644 crates/ampghost-gtk/data/icons/hicolor/scalable/apps/io.github.janick_foundry.AmpGhost.svg -t /app/share/icons/hicolor/scalable/apps",
        "install -Dm644 crates/ampghost-gtk/data/icons/hicolor/symbolic/apps/io.github.janick_foundry.AmpGhost-symbolic.svg -t /app/share/icons/hicolor/symbolic/apps",
        "install -Dm644 NOTICE /app/share/licenses/io.github.janick_foundry.AmpGhost/NOTICE",
        "install -Dm644 crates/ampghost-params/NOTICE /app/share/licenses/io.github.janick_foundry.AmpGhost/NOTICE-ampghost-params",
        "install -Dm644 crates/ampghost-gtk/data/icons/LICENSE-lucide crates/ampghost-gtk/data/icons/LICENSE-phosphor crates/ampghost-gtk/data/icons/LICENSE-adwaita -t /app/share/licenses/io.github.janick_foundry.AmpGhost"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            "target",
            ".flatpak-builder",
            "flatpak_app",
            "repo"
          ]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
